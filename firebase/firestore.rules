// posy — Firestore rules for the `bouquets` collection.
//
// If this Firebase project already has rules for another app, DON'T replace
// them: copy only the `match /bouquets/{id} { … }` block below into your
// existing `match /databases/{database}/documents { … }` section.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /bouquets/{id} {
      // Anyone with the link can open that one bouquet…
      allow get: if true;
      // …but nobody can list or browse bouquets.
      allow list: if false;

      // New bouquets must be well-formed. They can never be edited or deleted.
      allow create: if id.matches('^[A-Za-z0-9]{10}$')
        && request.resource.data.keys().hasOnly(['composition', 'message', 'recipient_name', 'sender_name', 'created_at'])
        && request.resource.data.keys().hasAll(['composition', 'message', 'created_at'])
        && request.resource.data.composition is string
        && request.resource.data.composition.size() > 10
        && request.resource.data.composition.size() <= 12000
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 800
        && (!('recipient_name' in request.resource.data) || (request.resource.data.recipient_name is string && request.resource.data.recipient_name.size() <= 60))
        && (!('sender_name' in request.resource.data) || (request.resource.data.sender_name is string && request.resource.data.sender_name.size() <= 60))
        && request.resource.data.created_at is timestamp;

      allow update, delete: if false;
    }
  }
}
