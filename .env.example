# posy needs no secret keys. Bouquets are stored in Cloud Firestore, and the
# rules in firebase/firestore.rules control access.
#
# Everything below is optional.

# Firebase project that holds the `bouquets` collection (defaults to ritual-caeea)
# FIREBASE_PROJECT_ID=ritual-caeea
# Firestore database id, if you use a named database instead of (default)
# FIRESTORE_DATABASE=(default)
# Firebase web API key — only used for quota attribution; it is not a secret
# FIREBASE_API_KEY=

# Public origin used when building share links (falls back to the request origin)
# NEXT_PUBLIC_SITE_URL=https://flower-shop-mitaliyadavvv.vercel.app
