# Supabase — server-side only. Never prefix these with NEXT_PUBLIC_.
# Project URL: Supabase dashboard → Project Settings → API (or Data API)
SUPABASE_URL=https://your-project-ref.supabase.co
# A secret key (sb_secret_…) or the legacy service_role key. Used only inside
# the /api/bouquets route and the server-rendered /bouquet/[id] page.
SUPABASE_SECRET_KEY=

# Optional: the public origin used when building share links (falls back to the request origin)
# NEXT_PUBLIC_SITE_URL=https://posy.example.com
